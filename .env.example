# ==============================================================================
# Autonomous Trading Sentinel — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your local credentials.
# The Sentinel can also run fully in mock test mode without any API keys:
#   python run_sentinel.py --test

# ------------------------------------------------------------------------------
# Telegram Remote Mobile Control
# ------------------------------------------------------------------------------
# Obtain from @BotFather on Telegram (e.g., 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567)
TELEGRAM_BOT_TOKEN=

# Obtain your numerical Telegram User / Chat ID from @userinfobot (e.g., 123456789)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Google Gemini AI Studio (Optional — for /reason institutional critiques)
# ------------------------------------------------------------------------------
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# If unset, the system automatically uses deterministic quantitative risk critiques.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# Pushover Notifications (Optional Secondary Channel)
# ------------------------------------------------------------------------------
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
